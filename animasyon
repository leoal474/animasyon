-- SADECE ANIMASYON MENÜSÜ
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 180)
MainFrame.Position = UDim2.new(0.4, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Active = true
MainFrame.Draggable = true

local function setAnim(idle, run, jump, fall)
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("Animate") then
        local a = char.Animate
        a.idle.AnimationId = "rbxassetid://" .. idle
        a.run.AnimationId = "rbxassetid://" .. run
        a.jump.AnimationId = "rbxassetid://" .. jump
        a.fall.AnimationId = "rbxassetid://" .. fall
        char:BreakJoints() -- Animasyonun işlemesi için karakteri yenile
    end
end

local function createBtn(name, pos, i, r, j, f)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.8, 0, 0, 30)
    btn.Position = pos
    btn.Text = name
    btn.MouseButton1Click:Connect(function() setAnim(i, r, j, f) end)
end

createBtn("ADIDAS STYLE", UDim2.new(0.1, 0, 0.1, 0), "616158929", "616163682", "616161997", "616160636")
