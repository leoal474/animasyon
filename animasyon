-- Adidas/Stylish Animasyon Sistemi (Profesyonel Yöntem)
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local animate = character:WaitForChild("Animate")

-- O adamın sistemindeki gibi animasyonları kökten değiştiriyoruz
local function applyAdidas()
    local anims = {
        idle = "rbxassetid://616158929",
        run = "rbxassetid://616163682",
        jump = "rbxassetid://616161997",
        fall = "rbxassetid://616160636"
    }
    
    for name, id in pairs(anims) do
        if animate:FindFirstChild(name) then
            animate[name].AnimationId = id
        end
    end
    
    -- Karakteri hemen resetlemeden animasyonları aktif etmek için Humanoid'i tetikle
    character.Humanoid.Jump = true 
    task.wait(0.1)
    character.Humanoid.Jump = false
end

-- Menü
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Btn = Instance.new("TextButton", ScreenGui)
Btn.Size = UDim2.new(0, 150, 0, 50)
Btn.Position = UDim2.new(0.5, -75, 0.5, 0)
Btn.Text = "ADIDAS ANIM: ACTIVE"
Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.Active = true
Btn.Draggable = true

Btn.MouseButton1Click:Connect(applyAdidas)

